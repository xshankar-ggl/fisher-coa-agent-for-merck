# Google Cloud & Secret Manager Configuration (Production Priority #1)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
THERMOFISHER_GEMINI_SECRET_ID=thermofisher-gemini-api-key

# Local Development Fallback (Priority #2 when Secret Manager is disabled/offline)
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Persistent Session & Vector Memory SQLite Path
THERMOFISHER_MEMORY_DB=/tmp/thermofisher_session_memory.sqlite3

# Server Port
PORT=8080
